# Copy to .env before `npm start` or `npm run build` to change the defaults.
# Create React App inlines these at build time, so a rebuild is required after
# any edit. Both are optional; an out-of-range value fails loudly at startup
# with the variable name in the message (see src/config.js).

# Side length of the square board. Integer, 2-8. Default: 4
REACT_APP_BOARD_SIZE=4

# Tile value that counts as a win. Power of two, at least 8. Default: 2048
REACT_APP_WIN_TILE=2048
